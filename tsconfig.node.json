{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "tests/e2e/**/*.ts"],
  // The e2e init-script entry imports src/ (bundler-style imports, parameter
  // properties) that this nodenext program cannot hold; svelte-check covers it
  // through src/core/sysex/fake-deluge.test.ts, and esbuild bundles it.
  "exclude": ["tests/e2e/fake-deluge.entry.ts"]
}
